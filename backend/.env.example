# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (PostgreSQL)
DB_NAME=medhub
DB_USER=medhub
DB_PASSWORD=medhub_secret
DB_HOST=localhost
DB_PORT=5432

# Redis (Cache + Channel layers)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_ACCESS_TOKEN_LIFETIME_HOURS=8
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# Storage (S3 / MinIO)
USE_S3=False
AWS_ACCESS_KEY_ID=medhub_access
AWS_SECRET_ACCESS_KEY=medhub_secret_key
AWS_STORAGE_BUCKET_NAME=medhub-media
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Django Channels
CHANNEL_LAYERS_BACKEND=channels_redis.core.RedisChannelLayer

# Neo4j Knowledge Graph
NEOMODEL_NEO4J_BOLT_URL=bolt://neo4j:medhub_secret@localhost:7687

# Local/Remote LLM Inference
# If your LLM server runs on another machine in your LAN, replace the host with that machine's IP.
LLM_API_URL=http://192.168.1.50:11434/api/generate
LLM_MODEL_NAME=medllama2
LLM_API_TIMEOUT_SECONDS=30

# Email (optional — SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Sentry (optional — error tracking)
SENTRY_DSN=
